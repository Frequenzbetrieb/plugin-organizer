{
  "Name": "Frequenzbetrieb Plugin Organizer",
  "Version": "0.9.1.0",
  "Author": "Frequenzbetrieb n.e.V.",
  "Description": "Loads your plugins into Ableton Live at the press of a key – with the plugin's real picture on the key. Requires the free Frequenzbetrieb Plugin Organizer.",
  "URL": "https://github.com/Frequenzbetrieb/plugin-organizer",
  "UUID": "de.frequenzbetrieb.pluginorganizer",
  "Icon": "imgs/plugin",
  "Category": "Frequenzbetrieb",
  "CategoryIcon": "imgs/category",
  "CodePath": "bin/plugin.js",
  "Nodejs": {
    "Version": "20",
    "Debug": "disabled"
  },
  "SDKVersion": 2,
  "Software": {
    "MinimumVersion": "6.5"
  },
  "OS": [
    {
      "Platform": "mac",
      "MinimumVersion": "12"
    },
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Actions": [
    {
      "UUID": "de.frequenzbetrieb.pluginorganizer.load",
      "Name": "Load plugin",
      "Tooltip": "Loads a plugin from Plugin Organizer into Ableton Live – onto the selected or a new track.",
      "Icon": "imgs/action",
      "PropertyInspectorPath": "ui/load.html",
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": true,
      "States": [
        {
          "Image": "imgs/key",
          "TitleAlignment": "bottom",
          "FontSize": "9",
          "ShowTitle": true
        }
      ]
    },
    {
      "UUID": "de.frequenzbetrieb.pluginorganizer.browse",
      "Name": "Open browser",
      "Tooltip": "Opens the plugin browser on the Stream Deck: page through areas, categories and plugins with pictures.",
      "Icon": "imgs/action",
      "PropertyInspectorPath": "ui/browse.html",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/browse",
          "TitleAlignment": "bottom",
          "FontSize": "9",
          "ShowTitle": true
        }
      ]
    },
    {
      "UUID": "de.frequenzbetrieb.pluginorganizer.slot",
      "Name": "Browser key",
      "Tooltip": "Content key of the plugin browser (used by the browser profile).",
      "Icon": "imgs/action",
      "Controllers": [
        "Keypad"
      ],
      "VisibleInActionsList": false,
      "States": [
        {
          "Image": "imgs/blank",
          "TitleAlignment": "bottom",
          "FontSize": "9",
          "ShowTitle": true
        }
      ]
    },
    {
      "UUID": "de.frequenzbetrieb.pluginorganizer.nav",
      "Name": "Browser navigation",
      "Tooltip": "Paging and back in the plugin browser (used by the browser profile).",
      "Icon": "imgs/action",
      "Controllers": [
        "Keypad"
      ],
      "VisibleInActionsList": false,
      "States": [
        {
          "Image": "imgs/nav",
          "TitleAlignment": "middle",
          "FontSize": "14",
          "ShowTitle": true
        }
      ]
    }
  ],
  "Profiles": [
    {
      "Name": "profiles/Frequenzbetrieb Browser",
      "DeviceType": 0,
      "Readonly": false,
      "DontAutoSwitchWhenInstalled": true
    }
  ]
}
