{
  "Name": "Frequenzbetrieb Plugin Organizer",
  "Version": "0.6.5.0",
  "Author": "Frequenzbetrieb n.e.V.",
  "Description": "Lädt deine Plugins per Tastendruck in Ableton Live – mit dem echten Bild des Plugins auf der Taste. Braucht den kostenlosen Frequenzbetrieb Plugin Organizer.",
  "URL": "https://github.com/Frequenzbetrieb/plugin-organizer",
  "UUID": "de.frequenzbetrieb.pluginorganizer",
  "Icon": "imgs/plugin",
  "Category": "Frequenzbetrieb",
  "CategoryIcon": "imgs/category",
  "CodePath": "bin/plugin.js",
  "Nodejs": {
    "Version": "20",
    "Debug": "disabled"
  },
  "SDKVersion": 2,
  "Software": {
    "MinimumVersion": "6.5"
  },
  "OS": [
    {
      "Platform": "mac",
      "MinimumVersion": "12"
    },
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Actions": [
    {
      "UUID": "de.frequenzbetrieb.pluginorganizer.load",
      "Name": "Plugin laden",
      "Tooltip": "Lädt ein Plugin aus dem Plugin Organizer in Ableton Live – auf die ausgewählte oder eine neue Spur.",
      "Icon": "imgs/action",
      "PropertyInspectorPath": "ui/load.html",
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": true,
      "States": [
        {
          "Image": "imgs/key",
          "TitleAlignment": "bottom",
          "FontSize": "9",
          "ShowTitle": true
        }
      ]
    },
    {
      "UUID": "de.frequenzbetrieb.pluginorganizer.browse",
      "Name": "Browser öffnen",
      "Tooltip": "Öffnet den Plugin-Browser auf dem Stream Deck: Bereiche, Kategorien und Plugins mit Bild durchblättern.",
      "Icon": "imgs/action",
      "PropertyInspectorPath": "ui/browse.html",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/browse",
          "TitleAlignment": "bottom",
          "FontSize": "9",
          "ShowTitle": true
        }
      ]
    },
    {
      "UUID": "de.frequenzbetrieb.pluginorganizer.slot",
      "Name": "Browser-Taste",
      "Tooltip": "Inhaltstaste des Plugin-Browsers (wird vom Browser-Profil benutzt).",
      "Icon": "imgs/action",
      "Controllers": [
        "Keypad"
      ],
      "VisibleInActionsList": false,
      "States": [
        {
          "Image": "imgs/blank",
          "TitleAlignment": "bottom",
          "FontSize": "9",
          "ShowTitle": true
        }
      ]
    },
    {
      "UUID": "de.frequenzbetrieb.pluginorganizer.nav",
      "Name": "Browser-Navigation",
      "Tooltip": "Blättern und zurück im Plugin-Browser (wird vom Browser-Profil benutzt).",
      "Icon": "imgs/action",
      "Controllers": [
        "Keypad"
      ],
      "VisibleInActionsList": false,
      "States": [
        {
          "Image": "imgs/nav",
          "TitleAlignment": "middle",
          "FontSize": "14",
          "ShowTitle": true
        }
      ]
    }
  ],
  "Profiles": [
    {
      "Name": "profiles/Frequenzbetrieb Browser",
      "DeviceType": 0,
      "Readonly": false,
      "DontAutoSwitchWhenInstalled": true
    }
  ]
}
