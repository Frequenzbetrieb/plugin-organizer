{
  "name": "frequenzbetrieb-plugin-organizer",
  "productName": "Frequenzbetrieb Plugin Organizer",
  "version": "0.5.1",
  "description": "Kostenloser Plugin-Organizer für Ableton Live: Plugins finden, sortieren, mit echten Vorschaubildern ansehen und per Klick oder Taste laden. Ein Open-Source-Projekt von Frequenzbetrieb n.e.V.",
  "main": "src/main.js",
  "scripts": {
    "start": "npm run build:native && electron .",
    "build:native": "node native/build.js",
    "dist:mac": "UNIVERSAL=1 node native/build.js && electron-builder --mac --universal --publish never && node streamdeck/build.js",
    "dist:win": "node native/build.js && electron-builder --win --x64 --publish never",
    "build:streamdeck": "node streamdeck/build.js"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.24.0",
    "ws": "^8.18.0"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.24.0": true
  },
  "author": "Frequenzbetrieb n.e.V. (https://www.frequenzbetrieb.de)",
  "license": "AGPL-3.0-only",
  "homepage": "https://www.frequenzbetrieb.de",
  "repository": {
    "type": "git",
    "url": "https://github.com/Frequenzbetrieb/plugin-organizer.git"
  },
  "bugs": {
    "url": "https://github.com/Frequenzbetrieb/plugin-organizer/issues"
  },
  "funding": "https://www.frequenzbetrieb.de/spenden/",
  "keywords": [
    "ableton",
    "ableton-live",
    "plugins",
    "vst",
    "vst3",
    "audio-unit",
    "music-production",
    "electron"
  ],
  "build": {
    "appId": "de.frequenzbetrieb.pluginorganizer",
    "productName": "Frequenzbetrieb Plugin Organizer",
    "copyright": "© Frequenzbetrieb n.e.V. – AGPL-3.0",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "LICENSE"
    ],
    "mac": {
      "category": "public.app-category.music",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "artifactName": "Frequenzbetrieb-Plugin-Organizer-macOS-universal.${ext}",
      "identity": null,
      "x64ArchFiles": "Contents/Resources/bin/*",
      "extendInfo": {
        "NSAppleEventsUsageDescription": "Der Plugin Organizer steuert Ableton Live, um Plugins auf die ausgewählte Spur zu laden.",
        "NSScreenCaptureUsageDescription": "Für den Live-Index fotografiert der Plugin Organizer Plugin-Fenster in Ableton Live."
      },
      "extraResources": [
        {
          "from": "bin",
          "to": "bin",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "dmg": {
      "title": "Plugin Organizer"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Frequenzbetrieb-Plugin-Organizer-Windows-x64.${ext}",
      "extraResources": [
        {
          "from": "bin",
          "to": "bin",
          "filter": [
            "*.exe"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Frequenzbetrieb-Plugin-Organizer-Windows-x64-Setup.${ext}"
    },
    "afterSign": "build/adhoc-sign.js"
  }
}
